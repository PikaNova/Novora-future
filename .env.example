# 复制为 .env 后填写真实值，不要提交到仓库。
# 本地 Docker 部署：compose 会自动注入 DATABASE_URL 指向内嵌 postgres 服务，这一项可以留空。
# Vercel/Neon 云端部署：填写 Neon 连接串。
# DATABASE_URL=postgresql://user:password@xxx.neon.tech/neondb?sslmode=require&channel_binding=require

# 首次启动超级管理员（可选；未配置时走原有恢复流程）
# ADMIN_PASSWORD=
# ADMIN_RECOVERY_KEY=

# 服务端口（本地 HTTP 部署）
PORT=3000
# CORS_ALLOWED_ORIGINS=

# 遥测与公告图上游。注意：公告正文图片依赖远端服务（/api/announcement-images 转发），
# 纯离线环境下公告图不可用，其余功能不受影响。全部留空则本地不发送遥测。
# TELEMETRY_BASE_URL=
# TELEMETRY_COLLECT_URL=
# TELEMETRY_TOKEN_URL=
# TELEMETRY_ANNOUNCE_URL=
# TELEMETRY_ERROR_REPORT_URL=
# TELEMETRY_IP_SALT=

# 更新检查 / 部署钩子（本地可全部留空，功能自动禁用）
# GITHUB_REPO=PikaNova/Novora
# GITHUB_TOKEN=
# VERCEL_DEPLOY_HOOK_URL=

# 入口限流调优（可选，有安全默认值）
# ENTRY_RATE_LIMIT_MAX_REQUESTS=30
# ENTRY_RATE_LIMIT_WINDOW_MS=10000
# ENTRY_RATE_LIMIT_WRITE_MAX_REQUESTS=8
# ENTRY_RATE_LIMIT_WRITE_WINDOW_MS=10000

# 前端构建开关：本地构建设为 false 以关闭 Vercel Speed Insights
VITE_SPEED_INSIGHTS=false
